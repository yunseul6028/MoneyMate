# MoneyMate 로컬 환경변수 (frontend/.env 로 복사해서 사용)
# LLM 키가 없으면 규칙기반(mock)으로 동작 — 키 없이도 전체 파이프라인 실행 가능

# mock | gemini | openai | openai_compatible
LLM_PROVIDER=mock

# --- Gemini (OpenAI 호환 엔드포인트) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# 날짜 감각: LIVE_DATE=false 면 DEMO_TODAY 로 고정(데모), true 면 실제 오늘
DEMO_TODAY=2026-08-15
LIVE_DATE=false

# DB (로컬은 SQLite. Vercel 은 코드에서 /tmp 로 자동 처리)
# DATABASE_URL=sqlite:///./moneymate.db
