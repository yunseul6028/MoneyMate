# MoneyMate 백엔드 환경변수

# LLM: 비워두면 Mock LLM(규칙기반)으로 동작 — 키 없이도 전체 파이프라인 실행 가능
LLM_PROVIDER=mock            # mock | openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# DB: MVP는 SQLite. 나중에 postgresql+psycopg://... 로 교체
DATABASE_URL=sqlite:///./moneymate.db

# 데모 기준 '오늘' (Mock 데이터가 이 날짜 기준으로 생성됨)
DEMO_TODAY=2026-08-13
