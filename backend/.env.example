# MoneyMate 백엔드 환경변수 (복사해서 .env 로 쓰세요)

# LLM: 비워두거나 mock 이면 규칙기반으로 동작 — 키 없이도 전체 파이프라인 실행 가능
# mock | gemini | openai | openai_compatible
LLM_PROVIDER=mock

# --- Gemini (OpenAI 호환 엔드포인트) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- OpenAI 호환 (Groq/Together/OpenRouter/Ollama 등) ---
COMPAT_API_KEY=
COMPAT_MODEL=
COMPAT_BASE_URL=

# DB: MVP는 SQLite. 나중에 postgresql+psycopg://... 로 교체
DATABASE_URL=sqlite:///./moneymate.db

# 데모 기준 '오늘' (Mock 데이터가 이 날짜 기준으로 생성됨)
DEMO_TODAY=2026-08-13
